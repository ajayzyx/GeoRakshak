{
  "name": "georakshak-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.23",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.18",
    "expo-location": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:live": "node scripts/run-check-live.mjs",
    "web": "expo start --web",
    "demo:web": "expo export --platform web && python3 -m http.server 5180 --directory dist --bind 127.0.0.1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testEnvironment": "node"
  }
