# GeoRakshak mobile — copy to .env and adjust. Placeholders only; never commit real values.
# Expo inlines EXPO_PUBLIC_* at bundle time: restart `npx expo start` after changing them.

# mock = in-app fictional SIMULATED_DEMO backend (no server needed, shows a MOCK DATA banner)
# live = call the GeoRakshak backend at EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_API_MODE=mock

# On a physical phone, "localhost" is the phone itself. Use the laptop's LAN IP, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
