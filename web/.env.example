# GeoRakshak web dashboard. Placeholder values only; never commit real secrets.

# live (default) calls the backend; mock uses bundled fictional SIMULATED_DEMO fixtures.
VITE_API_MODE=live

# Backend base URL including the version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional MapLibre style URL for a basemap. Leave empty (default) for a plain background.
# Set only after the provider's terms have been checked (decision H5). Do not use public OSM tile servers.
VITE_BASEMAP_STYLE_URL=
