# Copy to backend/.env for local overrides. Never commit real secrets.
DATABASE_URL=postgresql://localhost:5432/georakshak
TEST_DATABASE_URL=postgresql://localhost:5432/georakshak_test
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
MEDIA_DIR=./var/media
PUBLIC_BASE_URL=http://localhost:8000
RUN_MODE=DEMO_REPLAY
# LIVE mode only: seconds between monitoring cycles (0 disables the scheduler).
MONITOR_INTERVAL_S=900
# Weather adapter: none | open-meteo (non-IMD fallback, H16) | imd-weather-api (awaiting access).
WEATHER_PROVIDER=none
# Minimum seconds between provider fetches (a scheduled cycle reuses stored data in between).
WEATHER_MIN_INTERVAL_S=3600
# LIVE only: how long superseded assessments and old forecast issues are kept (0 disables pruning).
ASSESSMENT_RETENTION_DAYS=7
# LIVE mode refuses to start with the development defaults above. Only set this for local LIVE testing.
ALLOW_DEV_SETTINGS=false
# Local development only. Change before any cloud deployment.
DEMO_USER_PASSWORD=georakshak-local-demo
